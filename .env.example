# Application settings for local development.
APP_NAME=Simple RAG Chatbot
APP_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

IDRIVE_E2_ENDPOINT=
IDRIVE_E2_REGION=
IDRIVE_E2_ACCESS_KEY=
IDRIVE_E2_SECRET_KEY=
IDRIVE_E2_BUCKET=

VIRUS_SCAN_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Gemini API & Ingestion Pipeline Configuration
GOOGLE_API_KEY=
GEMINI_CAPTION_MODEL=gemini-2.0-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_OUTPUT_DIM=1024
EMBEDDING_DIM=1024
EMBED_MIN_SECONDS_BETWEEN_REQUESTS=1.0
EMBED_MAX_RETRIES=4
EMBED_RETRY_BASE_DELAY=2.0

# Chunking Configuration
CHUNK_TOKENIZER_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
HF_TOKEN=

# Lightweight PDF image extraction
MIN_IMAGE_AREA_RATIO=0.02
MIN_IMAGE_WIDTH=80
MIN_IMAGE_HEIGHT=80
MAX_GEMINI_CALLS_PER_DOC=20

# Worker Polling & Concurrency
WORKER_BATCH_SIZE=5
WORKER_MAX_CONCURRENCY=3
WORKER_POLL_INTERVAL_SECONDS=3
WORKER_STALE_PROCESSING_MINUTES=30
